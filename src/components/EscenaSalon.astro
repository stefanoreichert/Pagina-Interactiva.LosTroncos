---
import Foto from './Foto.astro';
---
<div class="room-scene scene" data-scene="salon" data-room-scene>
  <div class="room-stage">
    <h2 class="room-title" id="gallery-title"><span>Nuestro</span> <span>espacio</span></h2>
    <figure class="room-figure">
      <div class="room-window">
        <Foto name="interior" alt="Salón de Los Troncos con mesas, plantas y luz cálida." width={1280} height={960} sizes="(max-width:767px) 134vh, 100vw" />
      </div>
      <figcaption class="room-caption">
        <p>Adentro o al aire libre.</p>
        <p>Encontrá tu lugar en Los Troncos.</p>
      </figcaption>
    </figure>
  </div>
</div>
