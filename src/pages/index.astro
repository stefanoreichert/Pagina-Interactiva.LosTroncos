---
import '../styles/global.css';
import carta from '../data/carta.json';
import local from '../data/local.json';
import Foto from '../components/Foto.astro';

const money = (price: number | null) => price === null ? 'Consultar' : `$${new Intl.NumberFormat('es-AR').format(price)}`;
const links = [['#carta','Carta'],['#el-lugar','El lugar'],['#ambiente','Ambiente'],['#visitanos','Visitanos']];
const normalize = (s: string) => s.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLocaleLowerCase('es');
---
<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Los Troncos Resto Bar | Puerto Rico, Misiones</title>
    <meta name="description" content="Conocé Los Troncos Resto Bar en Puerto Rico, Misiones. Mirá nuestra carta de pizzas, hamburguesas, milanesas, pastas y bebidas. Encontrá horarios y ubicación." />
    <meta name="theme-color" content="#203D31" />
    <meta property="og:title" content="Los Troncos Resto Bar" />
    <meta property="og:description" content="Una mesa en Puerto Rico, Misiones. Conocé el lugar y mirá nuestra carta." />
    <meta property="og:type" content="website" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" href="/fonts/Erode-Medium.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/InstrumentSans-Regular.ttf" as="font" type="font/ttf" crossorigin />
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context':'https://schema.org', '@type':'Restaurant', name:local.name,
      address:{'@type':'PostalAddress',streetAddress:local.address,addressLocality:'Puerto Rico',addressRegion:'Misiones',postalCode:'N3334',addressCountry:'AR'},
      telephone:'+543743611895',hasMap:local.maps,
      sameAs:[local.instagram,local.facebook],
      openingHoursSpecification:{'@type':'OpeningHoursSpecification',dayOfWeek:['Thursday','Friday','Saturday','Sunday'],opens:'19:00',closes:'01:30'}
    })} />
  </head>
  <body>
    <a href="#contenido" class="skip-link">Saltar al contenido</a>
    <header class="header">
      <a class="brand" href="#inicio" aria-label="Los Troncos, inicio">
        <img src="/imagenes/logo.webp" alt="Los Troncos Resto Bar" width="480" height="264" fetchpriority="high" />
      </a>
      <nav class="desktop-nav" aria-label="Principal">
        {links.map(([href,label]) => <a href={href}>{label}</a>)}
      </nav>
      <details class="mobile-nav" id="navigation">
        <summary aria-controls="mobile-panel">
          <span class="when-closed">Secciones</span><span class="when-open">Cerrar</span>
          <svg class="nav-symbol" width="24" height="24" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 8h16M4 16h16" fill="none" stroke="currentColor" stroke-width="1.5" /></svg>
        </summary>
        <nav class="mobile-panel" id="mobile-panel" aria-label="Principal móvil">
          <div class="mobile-links">{links.map(([href,label]) => <a href={href}>{label}</a>)}</div>
          <div class="mobile-contact"><p>{local.address}<br />{local.city}</p><a href={local.instagram} target="_blank" rel="noopener noreferrer">Instagram</a></div>
        </nav>
      </details>
    </header>

    <main id="contenido">
      <section class="hero" id="inicio" aria-labelledby="hero-title">
        <div class="hero-copy frame">
          <h1 id="hero-title">Los Troncos</h1>
          <div class="hero-bottom">
            <div><p>Restaurante y bar en Puerto Rico, Misiones.</p><a class="button button-light" href="#carta">Ver la carta <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.5" /></svg></a></div>
            <p class="hero-hours">{local.hoursDays}<br /><span>19:00 a 01:30</span></p>
          </div>
        </div>
        <div class="hero-image"><Foto name="fachada" width={1280} height={960} alt="Fachada iluminada de Los Troncos Resto Bar, con mesas y plantas frente al local." eager sizes="100vw" /></div>
      </section>

      <section class="place frame section-space" id="el-lugar" aria-labelledby="place-title">
        <div class="place-copy">
          <h2 id="place-title">El lugar</h2>
          <p class="statement">Una mesa en Puerto Rico.<br />Y algo rico para compartir.</p>
          <p>De una pizza Palo Rosa a una hamburguesa Tacuarembó. En nuestra carta, los nombres de árboles se encuentran con pizzas, sándwiches y platos de cocina.</p>
          <p>Elegí lo que te gusta y conocé el espacio donde lo compartimos.</p>
          <a class="text-link" href="#ambiente">Conocé el ambiente</a>
        </div>
        <figure class="place-photo"><Foto name="pizza" width={960} height={1280} alt="Pizza Palo Rosa con mozzarella, jamón, tomates cherry y aceitunas, servida sobre una tabla." /><figcaption><span>Palo Rosa</span><a href="#grupo-pizzas" data-menu-link="pizzas">Ver pizzas</a></figcaption></figure>
      </section>

      <section class="menu-section section-space" id="carta" aria-labelledby="menu-title">
        <div class="frame">
          <div class="menu-heading"><h2 id="menu-title">La carta</h2><p>Pizzas, cocina y algo para brindar.<br />Elegí por dónde empezar.</p></div>
          <div class="menu-tools" id="menu-tools" hidden>
            <div class="menu-kind" role="group" aria-label="Tipo de carta">
              <button type="button" data-kind="cocina" aria-pressed="true" aria-controls="menu-results">Cocina</button>
              <button type="button" data-kind="bebidas" aria-pressed="false" aria-controls="menu-results">Bebidas</button>
            </div>
            <form class="menu-search" role="search" id="menu-search" action="/">
              <label for="search">Buscar en la carta</label>
              <div class="search-field"><svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="m16 16 5 5" stroke="currentColor" stroke-width="1.5" /></svg><input id="search" name="buscar" type="search" placeholder="Nombre o ingrediente…" autocomplete="off" maxlength="100" /><button type="button" id="clear-search" aria-label="Limpiar búsqueda" hidden><svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18" stroke="currentColor" stroke-width="1.5"/></svg></button></div>
            </form>
          </div>
          <div class="menu-layout">
            <aside class="menu-categories" aria-label="Categorías de la carta">
              <div class="mobile-category" hidden><label for="category">Categoría</label><select id="category" name="categoria"></select></div>
              <nav class="category-links" aria-label="Elegir categoría">
                <button type="button" class="all-category" data-category="todas" hidden>Toda la cocina</button>
                {carta.groups.map(group => <a href={`#grupo-${group.id}`} data-category={group.id} data-kind={group.kind}>{group.name}</a>)}
              </nav>
              <button type="button" class="text-link reset-menu" id="reset-menu" hidden>Ver toda la carta</button>
              <p class="menu-help">Los platos y bebidas se preparan según disponibilidad. Consultanos en el local.</p>
            </aside>
            <div class="menu-results" id="menu-results">
              <p class="result-status visually-hidden" id="result-status" aria-live="polite" aria-atomic="true" hidden></p>
              {carta.groups.map(group => <section class="menu-group" id={`grupo-${group.id}`} data-group={group.id} data-kind={group.kind} aria-labelledby={`title-${group.id}`}>
                <div class="group-heading"><h3 id={`title-${group.id}`}>{group.name}</h3><p class="group-count" aria-hidden="true">{group.items.length} opciones</p></div>
                {group.note && <p class="group-note">{group.note}</p>}
                <ul class="dish-list">{group.items.map(item => <li class="dish" data-search={normalize(`${item.name} ${item.description}`)}>
                  <div class="dish-heading"><h4>{item.name}</h4><span class:list={['dish-price',{'price-consult':item.price===null}]}>{money(item.price)}</span></div>
                  {item.description && <p>{item.description}</p>}
                </li>)}</ul>
              </section>)}
              <div class="empty-state" id="empty-state" hidden><h3>Sin coincidencias</h3><p>Probá otro nombre o ingrediente, o buscá en toda la carta.</p><div class="empty-actions"><button class="button" id="empty-clear" type="button">Limpiar búsqueda</button><button class="text-link" id="search-all" type="button">Buscar en toda la carta</button></div></div>
              <p class="menu-footnote">Precios sujetos a actualización. Las opciones sin importe se consultan en el local.</p>
            </div>
          </div>
        </div>
      </section>

      <section class="food-pair frame section-space" aria-label="Hamburguesas y sándwiches de la carta">
        <figure><Foto name="hamburguesa" width={960} height={1280} alt="Hamburguesa Tacuarembó con cheddar y panceta, acompañada de papas fritas." /><figcaption><span>Tacuarembó</span><a href="#grupo-hamburguesas" data-menu-link="hamburguesas">Ver hamburguesas</a></figcaption></figure>
        <figure><Foto name="sandwich" width={1200} height={1600} alt="Sándwich Ibirá en pan árabe, con carne desmechada y vegetales, acompañado de papas." /><figcaption><span>Ibirá</span><a href="#grupo-sandwiches" data-menu-link="sandwiches">Ver sándwiches</a></figcaption></figure>
      </section>

      <section class="atmosphere section-space" id="ambiente" aria-labelledby="atmosphere-title">
        <div class="frame atmosphere-title"><h2 id="atmosphere-title">Compartir la mesa</h2><p>Adentro o al aire libre.<br />Conocé nuestros espacios.</p></div>
        <div class="atmosphere-wide frame"><Foto name="interior" width={1280} height={960} alt="Salón interior de Los Troncos con mesas, plantas y lámparas cálidas." sizes="100vw" /></div>
        <div class="atmosphere-pair frame"><figure><Foto name="terraza" width={1200} height={1600} alt="Mesas de la terraza bajo una pérgola con guirnaldas de luces." /><figcaption>La terraza</figcaption></figure><figure><Foto name="mesa" width={960} height={1280} alt="Detalle de una mesa del local con flores y luz cálida." /><figcaption>Los detalles de la mesa</figcaption></figure></div>
      </section>

      <section class="visit section-space" id="visitanos" aria-labelledby="visit-title">
        <div class="frame">
          <h2 id="visit-title">Visitanos</h2>
          <div class="visit-grid">
            <div class="visit-address"><p>{local.address}</p><p>{local.city}</p><a class="button button-light" href={local.maps} target="_blank" rel="noopener noreferrer">Cómo llegar <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M7 17 17 7M7 7h10v10" fill="none" stroke="currentColor" stroke-width="1.5"/></svg></a></div>
            <div class="visit-hours"><h3>{local.hoursDays}</h3><p>{local.hoursTime}</p><p class="visit-phone">WhatsApp<br /><span class="phone-number">{local.phoneDisplay}</span></p><p class="socials"><a href={local.instagram} target="_blank" rel="noopener noreferrer">Instagram</a><a href={local.facebook} target="_blank" rel="noopener noreferrer">Facebook</a></p></div>
          </div>
        </div>
      </section>
    </main>
    <footer class="footer frame" id="footer">
      <a class="footer-brand" href="#inicio" aria-label="Volver al inicio"><img src="/imagenes/logo.webp" alt="Los Troncos Resto Bar" width="480" height="264" loading="lazy" /></a>
      <p>Puerto Rico, Misiones.</p>
      <a href="#carta">Volver a la carta</a>
    </footer>
    <script src="../scripts/main.ts"></script>
  </body>
</html>
