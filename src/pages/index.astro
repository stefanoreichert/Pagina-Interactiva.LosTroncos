---
import '../styles/global.css';
import local from '../data/local.json';
import carta from '../data/carta.json';
import Foto from '../components/Foto.astro';
import Icono from '../components/Icono.astro';
import Portada from '../components/Portada.astro';
import Carta from '../components/Carta.astro';
import EscenaSalon from '../components/EscenaSalon.astro';
const links=[['#inicio','Inicio'],['#carta','Carta'],['#nosotros','Nosotros'],['#galeria','Galería'],['#ubicacion','Ubicación']];
const highlights=[{name:'Palo Rosa',group:'pizzas',photo:'pizza',width:960,height:1280,alt:'Pizza Palo Rosa sobre una tabla de madera.'},{name:'Tacuarembó',group:'hamburguesas',photo:'hamburguesa',width:960,height:1280,alt:'Hamburguesa Tacuarembó acompañada de papas fritas.'},{name:'Ibirá',group:'sandwiches',photo:'sandwich',width:1200,height:1600,alt:'Sándwich Ibirá de carne desmechada en pan árabe.'}].map(d=>({...d,item:carta.groups.find(g=>g.id===d.group)?.items.find(i=>i.name===d.name)}));
const money=(n:number|null|undefined)=>n==null?'Consultar':`$${new Intl.NumberFormat('es-AR').format(n)}`;
---
<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/>
    <title>Los Troncos Resto Bar | Puerto Rico, Misiones</title>
    <meta name="description" content="Conocé Los Troncos Resto Bar en Puerto Rico, Misiones. Pizzas, hamburguesas, cocina y bebidas. Mirá la carta y consultá tu reserva por WhatsApp."/>
    <meta name="theme-color" content="#171512"/><meta property="og:title" content="Los Troncos Resto Bar"/><meta property="og:description" content="Una mesa para todos tus gustos en Puerto Rico, Misiones. Carta, ambiente y reservas por WhatsApp."/><meta property="og:type" content="website"/>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg"/>
    <link rel="preload" href="/fonts/Jost-Variable.ttf" as="font" type="font/ttf" crossorigin/>
    <link rel="preload" href="/fonts/InstrumentSans-Regular.ttf" as="font" type="font/ttf" crossorigin/>
    <script type="application/ld+json" set:html={JSON.stringify({'@context':'https://schema.org','@type':'Restaurant',name:local.name,address:{'@type':'PostalAddress',streetAddress:local.address,addressLocality:'Puerto Rico',addressRegion:'Misiones',postalCode:'N3334',addressCountry:'AR'},telephone:'+543743611895',hasMap:local.maps,sameAs:[local.instagram,local.facebook],openingHoursSpecification:{'@type':'OpeningHoursSpecification',dayOfWeek:['Thursday','Friday','Saturday','Sunday'],opens:'19:00',closes:'01:30'}})}/>
  </head>
  <body>
    <a href="#contenido" class="skip-link">Saltar al contenido</a>
    <header class="header">
      <a class="brand" href="#inicio" aria-label="Los Troncos, inicio"><img src="/imagenes/logo.webp" alt="Los Troncos Resto Bar" width="480" height="266"/></a>
      <nav class="desktop-nav" aria-label="Principal">{links.map(([href,label])=><a href={href}>{label}</a>)}<a href="#reservas" class="nav-book">Reservas <Icono name="up-right" size={17}/></a></nav>
      <details class="mobile-nav" id="navigation"><summary aria-controls="mobile-panel"><span class="when-closed">Menú</span><span class="when-open">Cerrar</span><svg width="24" height="24" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 8h16M4 16h16" stroke="currentColor" stroke-width="1.5"/></svg></summary><nav class="mobile-panel" id="mobile-panel" aria-label="Principal móvil"><div class="mobile-links">{links.map(([href,label])=><a href={href}>{label}</a>)}<a href="#reservas">Reservas</a></div><div class="mobile-contact"><p>{local.address}<br/>{local.city}</p><a href={local.whatsapp} target="_blank" rel="noopener noreferrer">WhatsApp <Icono name="up-right" size={17}/></a></div></nav></details>
    </header>
    <main id="contenido">
      <Portada/>
      <section class="proposal frame section-space" id="nosotros" aria-labelledby="proposal-title"><span id="el-lugar" class="anchor-alias" aria-hidden="true"></span><div class="section-intro"><h2 id="proposal-title" class="editorial-statement">Distintos gustos.<br/>La misma mesa.</h2></div><div class="proposal-bottom"><p>De una pizza Palo Rosa a una hamburguesa Tacuarembó. En Los Troncos, los nombres de árboles se encuentran con pizzas, sándwiches y platos de cocina.</p><p>Estamos en Puerto Rico, Misiones. Vení por algo rico, elegí tu lugar y compartí la noche.</p><a class="text-link" href="#galeria">Conocé nuestro espacio <Icono name="up-right"/></a></div></section>
      <section class="specialties frame section-space" id="especialidades" aria-labelledby="specialties-title"><div class="section-heading"><h2 id="specialties-title">Para empezar<br/>a elegir</h2><p>Tres opciones de nuestra carta.<br/>Cada una, con nombre propio.</p></div><div class="specialty-layout">{highlights.map(d=><article class="specialty"><a class="photo-link" href={`#grupo-${d.group}`} data-menu-link={d.group} aria-label={`Ver ${d.name} en la carta`}><Foto name={d.photo} alt={d.alt} width={d.width} height={d.height}/><span class="photo-link-arrow"><Icono name="up-right" size={24}/></span></a><div class="specialty-title"><h3>{d.name}</h3><span>{money(d.item?.price)}</span></div><p>{d.item?.description}</p></article>)}</div></section>
      <Carta/>
      <section class="gallery section-space" id="galeria" aria-labelledby="gallery-title"><span id="ambiente" class="anchor-alias" aria-hidden="true"></span><EscenaSalon/><div class="gallery-pair frame"><figure class="reveal-photo"><Foto name="terraza" alt="Mesas de la terraza con guirnaldas de luces." width={1200} height={1600}/><figcaption>La terraza</figcaption></figure><figure class="gallery-detail reveal-photo"><Foto name="mesa" alt="Flores y detalles de una mesa del resto bar." width={960} height={1280}/><figcaption>Los detalles de la mesa</figcaption></figure></div></section>
      <section class="reservations section-space" id="reservas" aria-labelledby="reservations-title"><div class="frame reservation-layout"><div><h2 id="reservations-title">Nos vemos<br/>en la mesa.</h2><p>Consultá por una reserva a través de WhatsApp. Coordinamos los detalles por ese canal.</p><a class="button button-accent" href={local.whatsapp} target="_blank" rel="noopener noreferrer">Reservar por WhatsApp <Icono name="up-right"/></a><p class="reservation-note">La reserva queda sujeta a la confirmación del local.</p></div><div class="reservation-photo reveal-photo"><Foto name="fachada" width={1280} height={960} alt="Entrada de Los Troncos Resto Bar iluminada por la noche."/><p>{local.hoursDays}<br/><strong>{local.hoursTime}</strong></p></div></div></section>
      <section class="location frame section-space" id="ubicacion" aria-labelledby="location-title"><span id="visitanos" class="anchor-alias" aria-hidden="true"></span><div class="location-copy"><h2 id="location-title">Acá nos<br/>encontramos.</h2><address>{local.address}<br/>{local.city}</address><p>{local.hoursDays}<br/>{local.hoursTime}</p><a class="text-link" href={local.maps} target="_blank" rel="noopener noreferrer">Cómo llegar <Icono name="up-right"/></a></div><div class="map-panel"><div class="map-placeholder" id="map-placeholder"><Icono name="pin" size={40}/><p>Los Troncos Resto Bar</p><span>{local.address}<br/>{local.city}</span><button type="button" class="button button-cream" id="load-map" hidden>Mostrar mapa <Icono name="plus" size={18}/></button><noscript><a class="button button-cream" href={local.maps} target="_blank" rel="noopener noreferrer">Abrir en Google Maps</a></noscript></div><div id="map-container" hidden></div></div></section>
    </main>
    <footer class="footer frame" id="footer"><div class="footer-top"><a class="footer-brand" href="#inicio" aria-label="Volver al inicio"><img src="/imagenes/logo.webp" alt="Los Troncos Resto Bar" width="480" height="266" loading="lazy"/></a><p>Una mesa en<br/>Puerto Rico, Misiones.</p><div class="footer-links"><a href={local.whatsapp} target="_blank" rel="noopener noreferrer">WhatsApp <Icono name="up-right" size={16}/></a><a href={local.instagram} target="_blank" rel="noopener noreferrer">Instagram <Icono name="up-right" size={16}/></a><a href={local.facebook} target="_blank" rel="noopener noreferrer">Facebook <Icono name="up-right" size={16}/></a></div></div><p class="footer-wordmark" aria-hidden="true">Los Troncos</p><div class="footer-bottom"><span>Los Troncos Resto Bar</span><span>{local.phoneDisplay}</span><a href="#inicio">Volver arriba <Icono name="up-right" size={16}/></a></div></footer>
    <script src="../scripts/main.ts"></script>
  </body>
</html>
